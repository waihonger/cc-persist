{
  "name": "cc-persist",
  "displayName": "cc-persist",
  "description": "Persistent Claude Code terminal sessions via session ID resume",
  "version": "0.6.0",
  "publisher": "fongy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "cc-persist",
      "properties": {
        "cc-persist.resumeFlags": {
          "type": "string",
          "default": "--dangerously-skip-permissions",
          "description": "Flags passed to Claude Code when restoring a saved session."
        },
        "cc-persist.closeRogueTerminals": {
          "type": "boolean",
          "default": true,
          "description": "Close untracked terminals that VS Code creates while saved Claude sessions are being restored."
        },
        "cc-persist.notifications": {
          "type": "boolean",
          "default": false,
          "description": "Show a toast when Claude finishes or needs input in a background terminal."
        }
      }
    },
    "commands": [
      {
        "command": "cc-persist.newTerminal",
        "title": "New Claude Terminal",
        "category": "cc-persist"
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "vscode:prepublish": "npm run compile -- --minify",
    "package": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
